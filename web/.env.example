# Copy to .env (or set in your host's dashboard). Only the first two are required.
NODE_ENV=production
ENCRYPTION_KEY=            # 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLIC_URL=https://your-domain.com
ADMIN_EMAIL=you@example.com   # this account gets the Admin page
PORT=3000
DB_FILE=data/quantpocket.db

# Market data for backtests (any Alpaca key; free paper keys work)
ALPACA_KEY_ID=
ALPACA_SECRET=

# AI strategy builder (Claude). Without it a keyword parser is used.
ANTHROPIC_API_KEY=

# SMS + voice hotline
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1...

# Plans + debit card deposits
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...
